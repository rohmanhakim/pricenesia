{
  "name": "@pricenesia/ingestion-api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "tsc --noEmit",
    "migrate": "wrangler d1 migrations apply $(grep DB_NAME .env | cut -d'=' -f2) --local",
    "test": "hurl --test --variables-file .env tests/",
    "test:ci": "hurl --test --variables-file .env.ci tests/",
    "test:clean": "bash tests/reset-db.sh .env && hurl --test --variables-file .env tests/"
  },
  "dependencies": {
    "@effect/platform": "0.94.5",
    "@effect/sql": "0.49.0",
    "@effect/sql-d1": "0.47.0",
    "@pricenesia/shared": "workspace:*",
    "effect": "3.19.18",
    "hono": "4.12.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260219.0",
    "typescript": "5.9.3",
    "wrangler": "4.66.0"
  }
}